generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id                String             @id @default(cuid())
  clerkId           String             @unique
  email             String             @unique
  firstName         String?
  lastName          String?
  phone             String?
  role              Role               @default(CLIENT)
  isBlocked         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  
  // Profile fields merged
  avatar            String?
  adminLevel        Int                @default(1)
  lat               Float?
  lng               Float?
  isAvailable       Boolean            @default(true)

  bikes             Bike[]
  requests          RepairRequest[]    @relation("ClientRequests")
  interventions     RepairRequest[]    @relation("TechnicianInterventions")
  sectors           Sector[]           @relation("TechnicianSectors")
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Bike {
  id           String          @id @default(cuid())
  brand        String
  modelName    String?
  type         String?
  photos       String[]        @default([])
  imageUrl     String?
  bikeIndexId  String?
  notes        String?
  userId       String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id])
  requests     RepairRequest[]
}


model RepairRequest {
  id               String                @id @default(cuid())
  address          String
  lat              Float?
  lng              Float?
  description      String
  photos           String[]              @default([])
  bikePhotos       String[]              @default([])
  issuePhotos      String[]              @default([])
  userId           String?
  bikeId           String?
  servicePackageId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  bikeImageUrl     String?
  bikeIndexId      String?
  bikeDetails      Json?                 @default("{}")
  clientFirstName  String?
  clientLastName   String?
  clientEmail      String?
  clientPhone      String?
  
  // Fields merged from Appointment
  technicianId     String?
  scheduledAt      DateTime?
  status           AppointmentStatus     @default(PENDING)
  isChatOpen       Boolean               @default(true)
  
  messages         Message[]
  products         InterventionProduct[]
  bike             Bike?                 @relation(fields: [bikeId], references: [id])
  servicePackage   ServicePackage?       @relation(fields: [servicePackageId], references: [id])
  user             User?                 @relation("ClientRequests", fields: [userId], references: [id])
  technician       User?                 @relation("TechnicianInterventions", fields: [technicianId], references: [id])
}

model ServicePackage {
  id           String          @id @default(cuid())
  title        String
  description  String
  price        Float
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  image        String?
  duration_min Int             @default(30)
  requests     RepairRequest[]
}



model Message {
  id             String       @id @default(cuid())
  requestId      String
  senderId       String
  senderRole     Role
  content        String
  attachments    String[]     @default([])
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  reactions      Json         @default("[]")
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  request        RepairRequest @relation(fields: [requestId], references: [id])
}

model Product {
  id            String                @id @default(cuid())
  name          String
  description   String?
  price         Float
  image         String?
  category      String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  interventions InterventionProduct[]
}

model InterventionProduct {
  id        String        @id @default(cuid())
  requestId String
  productId String
  quantity  Int           @default(1)
  price     Float
  createdAt DateTime      @default(now())
  product   Product       @relation(fields: [productId], references: [id])
  request   RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Sector {
  id          String                  @id @default(cuid())
  name        String                  @unique
  boundary    Unsupported("geometry")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  color       String?                 @default("#3bb2d0")
  technicians User[]                  @relation("TechnicianSectors")

  @@index([boundary], map: "sector_boundary_idx", type: Gist)
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}


enum AppointmentStatus {
  PENDING
  SCHEDULED
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}
