generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model User {
  id                String             @id @default(cuid())
  clerkId           String             @unique
  email             String             @unique
  firstName         String?
  lastName          String?
  phone             String?
  role              Role               @default(CLIENT)
  isBlocked         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  adminProfile      AdminProfile?
  bikes             Bike[]
  requests          RepairRequest[]
  technicianProfile TechnicianProfile?
}

model Bike {
  id           String          @id @default(cuid())
  brand        String
  modelName    String?
  modelId      String?
  typeId       String?
  color        String?
  serialNumber String?         @unique
  photos       String[]        @default([])
  userId       String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  model        BikeModel?      @relation(fields: [modelId], references: [id])
  type         BikeType?       @relation(fields: [typeId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  requests     RepairRequest[]
}

model BikeType {
  id        String      @id @default(cuid())
  name      String      @unique
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bikes     Bike[]
  models    BikeModel[]
}

model BikeModel {
  id        String   @id @default(cuid())
  name      String
  brand     String
  photo     String?
  typeId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bikes     Bike[]
  type      BikeType @relation(fields: [typeId], references: [id])
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  avatar    String?
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model TechnicianProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  avatar       String?
  lat          Float?
  lng          Float?
  isAvailable  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
  user         User          @relation(fields: [userId], references: [id])
  sectors      Sector[]      @relation("TechnicianSectors")
}

model RepairRequest {
  id               String          @id @default(cuid())
  address          String
  lat              Float?
  lng              Float?
  description      String
  photos           String[]        @default([])
  status           RequestStatus   @default(PENDING)
  
  // Client Info (for guest/admin-created interventions)
  userId           String?
  clientFirstName  String?
  clientLastName   String?
  clientPhone      String?
  
  // Bike Info (integrated in request for one-off interventions)
  bikeId           String?
  bikeModel        String?
  bikeType         String? // VTT, VTC, VAE
  
  servicePackageId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  appointment      Appointment?
  bike             Bike?           @relation(fields: [bikeId], references: [id])
  servicePackage   ServicePackage? @relation(fields: [servicePackageId], references: [id])
  user             User?            @relation(fields: [userId], references: [id])
  products         InterventionProduct[]
}

model ServicePackage {
  id          String          @id @default(cuid())
  title       String
  description String
  price       Float
  duration_min    Int             @default(30)
  image       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  requests    RepairRequest[]
}

model Appointment {
  id           String            @id @default(cuid())
  requestId    String            @unique
  technicianId String
  scheduledAt  DateTime
  status       AppointmentStatus @default(SCHEDULED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  request      RepairRequest     @relation(fields: [requestId], references: [id])
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  image       String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  interventions InterventionProduct[]
}

model InterventionProduct {
  id          String        @id @default(cuid())
  requestId   String
  productId   String
  quantity    Int           @default(1)
  price       Float         // Price at the time of the intervention
  request     RepairRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  createdAt   DateTime      @default(now())
}

model Sector {
  id          String                  @id @default(cuid())
  name        String                  @unique
  boundary    Unsupported("geometry")
  color       String?                 @default("#3bb2d0")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  technicians TechnicianProfile[]     @relation("TechnicianSectors")

  @@index([boundary], map: "sector_boundary_idx", type: Gist)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  CLIENT
  TECHNICIAN
  ADMIN
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentStatus {
  SCHEDULED
  EN_ROUTE
  ON_SITE
  COMPLETED
  CANCELLED
}
